{
  "name": "@yuki-byte18/adapters",
  "version": "0.1.0",
  "description": "外部工具适配器：把工具原始输出翻译成 shared 类型",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "perfpilot",
    "lighthouse",
    "ts-morph",
    "web-performance"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@yuki-byte18/shared": "workspace:*",
    "ts-morph": "^28.0.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
