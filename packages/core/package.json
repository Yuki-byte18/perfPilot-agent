    "typecheck": "tsc -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@yuki-byte18/shared": "workspace:*",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@yuki-byte18/adapters": "workspace:*",
    "ai": "^7.0.137"
  }
