{
  "name": "@yuki-byte18/core",
  "version": "0.1.0",
  "description": "核心引擎：线性流水线、采集归并、报告渲染",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
